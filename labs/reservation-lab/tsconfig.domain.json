{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".domain-build",
    "skipLibCheck": true
  },
  "include": ["lib/contracts.ts", "lib/catalog.ts", "lib/reservation-store.ts", "lib/booking-request.ts"],
  "exclude": ["node_modules", ".domain-build"]
}